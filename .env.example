# Debrisat: environment variables for the Supabase Edge Functions.
# Never commit real values. Set them with `supabase secrets set NAME=value` (or Project Settings > Edge Functions > Secrets).
# The static site needs none of these: its public URL and anon key live in js/config.js by design.

# ---------- Supabase (provided automatically inside Edge Functions) ----------
# Project URL, https://<project-ref>.supabase.co. Required (auto-injected by Supabase).
SUPABASE_URL=
# Service-role key, bypasses RLS: server only, never in the browser. Required (auto-injected). Rotate it if it ever leaked.
SUPABASE_SERVICE_ROLE_KEY=
# Allowed browser origin for CORS, e.g. https://projet-debrisat-team-dakar-house.vercel.app. Optional (defaults to *).
ORIGINE_AUTORISEE=

# ---------- WhatsApp official agent: Meta Cloud API (function whatsapp-meta) ----------
# Permanent System User access token (Meta Business Settings > System users). Required.
WHATSAPP_TOKEN=
# Phone number ID of +221 78 427 72 29 (WhatsApp Manager > API Setup). Required.
WHATSAPP_PHONE_NUMBER_ID=
# WhatsApp Business Account ID (WhatsApp Manager > API Setup). Required for template management.
WHATSAPP_BUSINESS_ACCOUNT_ID=
# Any long random string you choose; paste the same value in the Meta webhook settings. Required.
WHATSAPP_VERIFY_TOKEN=
# Meta app secret (App Dashboard > App settings > Basic), used to check X-Hub-Signature-256. Required.
WHATSAPP_APP_SECRET=
# Graph API version, e.g. v21.0. Optional (default v21.0); check Meta's current version.
WHATSAPP_GRAPH_VERSION=
# Long random string shared with the Supabase Database Webhook (header x-debrisat-secret) for status notifications. Required for notifications.
WHATSAPP_INTERNAL_SECRET=
# Approved template name for status updates outside the 24 h window, e.g. debrisat_statut_signalement. Optional (no out-of-window notification without it).
WHATSAPP_TEMPLATE_STATUT=
# Approved template name for the human-handoff team alert, e.g. debrisat_alerte_equipe. Optional (falls back to a plain message).
WHATSAPP_TEMPLATE_EQUIPE=
# Team number alerted on "Parler à un humain", E.164 without +, e.g. 2217XXXXXXXX. Required for human handoff.
TEAM_ALERT_NUMBER=

# ---------- WhatsApp legacy bot and SMS: Twilio (functions webhook-whatsapp, envoyer-alerte) ----------
# Twilio Account SID (Twilio Console). Required while the Twilio bot or SMS alerts are used.
TWILIO_ACCOUNT_SID=
# Twilio Auth Token, also used to check X-Twilio-Signature. Required with Twilio.
TWILIO_AUTH_TOKEN=
# Sending number for SMS alerts, E.164. Required for SMS alerts.
TWILIO_NUMERO_SMS=
# Twilio WhatsApp sender, e.g. whatsapp:+14155238886. Required for the Twilio bot and WhatsApp alerts.
TWILIO_NUMERO_WHATSAPP=
# Exact public URL configured in Twilio for the webhook (part of the signature). Optional (defaults to the function URL).
TWILIO_WEBHOOK_URL=

# ---------- AI photo analysis (function analyser-image) and WhatsApp AI fallback ----------
# Anthropic API key (console.anthropic.com). Optional: without it, photos are not analysed and the bot has no AI fallback.
ANTHROPIC_API_KEY=
# Claude model id. Optional (default claude-opus-5-5).
CLAUDE_MODELE=
# Roboflow API key for the optional object detector. Optional.
ROBOFLOW_API_KEY=
# Roboflow model id, e.g. project/version. Optional.
ROBOFLOW_MODELE=

# ---------- Satellite imagery (functions imagerie-copernicus, proxy-oneatlas) ----------
# Copernicus Data Space Ecosystem OAuth client id (dataspace.copernicus.eu). Optional (satellite admin tools).
CDSE_CLIENT_ID=
# Copernicus Data Space Ecosystem OAuth client secret. Optional.
CDSE_CLIENT_SECRET=
# Airbus OneAtlas API key. Optional.
ONEATLAS_API_KEY=
